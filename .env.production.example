# Inject actual values from the deployment's secret/configuration store.
# This template is intentionally incomplete; it is not a deployable environment.
SPRING_PROFILES_ACTIVE=production
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
SESSION_SECRET=
PUBLIC_ORIGIN=https://158.160.223.177
SESSION_COOKIE_SECURE=true
FSP_DEMO_MODE=false
FSP_SEED_DEMO=false
FSP_PROCTORING_ENABLED=false
FSP_PROCTORING_MEDIA_ROOT=/var/lib/fsp/proctoring
FSP_PROCTORING_RETENTION_DAYS=7
FSP_PROCTORING_MAX_CHUNK_BYTES=4194304
FSP_PROCTORING_MAX_SESSION_BYTES=268435456
# Required for infra/compose.proctoring-tls.yml; certificate issuance is a separate operator action.
TLS_HOST=158.160.223.177
TLS_EMAIL=replace-with-operator-email@example.invalid
TLS_LETSENCRYPT_DIR=./local/tls/letsencrypt
TLS_ACME_WEBROOT=./local/tls/webroot
TLS_BIND_ADDRESS=0.0.0.0
TLS_HTTP_PORT=80
TLS_HTTPS_PORT=443
# The published demo bank must not issue real grades.
FSP_ASSESSMENT_REAL_GRADE_ENABLED=false
